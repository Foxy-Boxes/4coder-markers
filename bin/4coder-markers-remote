#!/bin/bash
# 4coder-markers-remote: install and update the 4coder-markers daemon on a remote
# server over ssh, and forward a local port to it so 4coder sees what agents on
# that server post.
#
#   4coder-markers-remote deploy HOST [--dir DIR] [--state DIR] [--remote-port P]
#       copy the sources to HOST, build there if they changed, and (re)start the
#       daemon. Running it again is how a server is kept up to date.
#   4coder-markers-remote connect HOST [--dir DIR] [--local-port P] [--remote-port P] [--no-deploy]
#       deploy, then forward 127.0.0.1:P (default 7341) here to the daemon there
#   4coder-markers-remote disconnect HOST [--local-port P]
#   4coder-markers-remote status HOST [--dir DIR] [--local-port P]
#   4coder-markers-remote stop HOST [--dir DIR]
#
# --dir (default ~/.4coder-markers, on HOST) receives the binary, sources,
# README.md and AGENT_PROMPT.md; it can be shared, e.g. a project directory.
# --state (default ~/.4coder-markers, per user) holds the daemon's store, pid and
# log. --remote-port (default 7341) is the daemon's port on HOST: loopback ports
# are shared by every user of a machine, so pick another one there if it is taken.
# HOST is anything ssh accepts, including user@host and names from ~/.ssh/config.
#
# ~/.4coder-markers-remote.conf holds per-host defaults, one host per line, used
# before the options given on the command line:
#   user@server  --dir /shared/project/4coder-markers --remote-port 7342
set -euo pipefail

ME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$ME")"

usage(){
    sed -n '2,24p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit "${1:-1}"
}

[ $# -ge 2 ] || usage
CMD="$1"; HOST="$2"; shift 2
CONF="$HOME/.4coder-markers-remote.conf"
if [ -f "$CONF" ]; then
    defaults="$(awk -v h="$HOST" '$1 == h { $1 = ""; print; exit }' "$CONF")"
    # shellcheck disable=SC2086
    [ -n "$defaults" ] && set -- $defaults "$@"
fi
DIR='~/.4coder-markers'
STATE='~/.4coder-markers'
LOCAL_PORT=7341
REMOTE_PORT=7341
DEPLOY=1
while [ $# -gt 0 ]; do
    case "$1" in
        --dir) DIR="$2"; shift 2;;
        --state) STATE="$2"; shift 2;;
        --local-port) LOCAL_PORT="$2"; shift 2;;
        --remote-port) REMOTE_PORT="$2"; shift 2;;
        --no-deploy) DEPLOY=0; shift;;
        -h|--help) usage 0;;
        *) echo "4coder-markers-remote: unknown option $1" >&2; usage;;
    esac
done
case "$HOST" in -*|"") echo "4coder-markers-remote: bad host '$HOST'" >&2; exit 1;; esac

# NOTE: share 4coder's ssh connection to the host (same ControlPath as its ssh layer)
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10 -o ControlMaster=auto
          -o "ControlPath=~/.ssh/4coder-%C" -o ControlPersist=600)
TUNNEL_SOCKET="$HOME/.ssh/4coder-markers-tunnel-$LOCAL_PORT"

q(){ printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# NOTE: remote SCRIPT [NAME VALUE]...: runs SCRIPT on HOST with DIR and STATE (tilde
# expanded), PORT and the given variables set; stdin goes to the script
remote(){
    local script="$1"; shift
    local vars="DIR=$(q "$DIR"); STATE=$(q "$STATE"); PORT=$(q "$REMOTE_PORT");"
    vars="$vars case \"\$DIR\" in '~'*) DIR=\"\$HOME\${DIR#\\~}\";; esac;"
    vars="$vars case \"\$STATE\" in '~'*) STATE=\"\$HOME\${STATE#\\~}\";; esac;"
    while [ $# -gt 0 ]; do vars="$vars $1=$(q "$2");"; shift 2; done
    ssh "${SSH_OPTS[@]}" -- "$HOST" "sh -c $(q "$vars FCODER_MARKERS_PORT=\$PORT; export FCODER_MARKERS_PORT; $script")"
}

FILES=(Makefile src/4coder_markers.cpp protocol/4coder_agent_markers_protocol.h
       protocol/4coder_agent_stories_protocol.h README.md AGENT_PROMPT.md
       skills/explain-code/SKILL.md)

source_hash(){
    (cd "$ROOT" && cat "${FILES[@]}") | shasum -a 256 | cut -c1-16
}

version(){
    local v=""
    # NOTE: a copy without its own git (e.g. next to the 4coder binary) carries a VERSION file
    if [ -f "$ROOT/VERSION" ]; then
        v="$(cat "$ROOT/VERSION")"
    elif [ "$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null)" = "$(cd "$ROOT" && pwd -P)" ]; then
        v="$(git -C "$ROOT" describe --always --dirty 2>/dev/null || true)"
    fi
    echo "${v:-src}+$(source_hash)"
}

BUILD_SCRIPT='set -e
cd "$DIR/.incoming"
rm -rf build && mkdir build && cd build
tar xzf ../src.tar.gz
CXX="${CXX:-c++}"
command -v "$CXX" >/dev/null 2>&1 || CXX=g++
command -v "$CXX" >/dev/null 2>&1 || CXX=clang++
command -v "$CXX" >/dev/null 2>&1 || { echo "deploy: no C++ compiler on $(hostname)" >&2; exit 1; }
"$CXX" -std=c++11 -O2 -Wall -Wno-unused-function -DFCODER_MARKERS_VERSION="\"$VERSION\"" \
    src/4coder_markers.cpp -o 4coder-markers
mkdir -p "$DIR/src" "$DIR/protocol"
cp src/* "$DIR/src/"; cp protocol/* "$DIR/protocol/"; cp Makefile README.md "$DIR/"
sed -e "s|@DIR@|$DIR|g" -e "s|@PORT@|$PORT|g" AGENT_PROMPT.md > "$DIR/AGENT_PROMPT.md"
mkdir -p "$DIR/skills/explain-code"
sed -e "s|@BIN@|$DIR/4coder-markers|g" -e "s|@README@|$DIR/README.md|g" -e "s|@PORT@|$PORT|g" \
    -e "s|@VERSION@|$VERSION|g" skills/explain-code/SKILL.md > "$DIR/skills/explain-code/SKILL.md"
chmod -R a+rX "$DIR/skills" "$DIR/AGENT_PROMPT.md" "$DIR/README.md"
# NOTE: rename over the old binary; a running daemon keeps the file it started from
mv 4coder-markers "$DIR/4coder-markers.new" && mv "$DIR/4coder-markers.new" "$DIR/4coder-markers"
echo "$HASH" > "$DIR/source.sha256"
cd "$DIR" && rm -rf .incoming'

# NOTE: restart the daemon when it runs anything but the installed binary
RESTART_SCRIPT='B="$DIR/4coder-markers"
VERSION="$("$B" version | cut -d" " -f2)"
running="$("$B" daemon status --state "$STATE" 2>/dev/null || true)"
case "$running" in
    *"version $VERSION,"*) ;;
    running*)
        "$B" daemon stop --state "$STATE" || { echo "deploy: another service holds port $PORT on $(hostname): $running" >&2; exit 1; }
        "$B" daemon start --state "$STATE" || exit 1;;
    *) "$B" daemon start --state "$STATE" || exit 1;;
esac
"$B" daemon status --state "$STATE"
# NOTE: a link, so every later deploy updates the skill; only for users of Claude
# Code, and never over a skill of the same name that is not ours
S="$HOME/.claude/skills/explain-code"
if [ -d "$HOME/.claude" ] && { [ ! -e "$S" ] || [ -L "$S" ]; }; then
    mkdir -p "$HOME/.claude/skills" && ln -sfn "$DIR/skills/explain-code" "$S"
    echo "skill: $S -> $DIR/skills/explain-code"
fi
echo "other users install the explain-code skill with: mkdir -p ~/.claude/skills && ln -sfn $DIR/skills/explain-code ~/.claude/skills/explain-code"
echo "agents use $B on port $PORT (docs $DIR/README.md, prompt $DIR/AGENT_PROMPT.md)"'

deploy(){
    local hash ver installed
    hash="$(source_hash)"
    ver="$(version)"
    installed="$(remote 'test -x "$DIR/4coder-markers" && cat "$DIR/source.sha256" 2>/dev/null || true')"
    if [ "$installed" != "$hash" ]; then
        echo "deploy: building $ver on $HOST"
        (cd "$ROOT" && COPYFILE_DISABLE=1 tar --no-xattrs -czf - "${FILES[@]}") |
            remote 'mkdir -p "$DIR/.incoming" && cat > "$DIR/.incoming/src.tar.gz"'
        remote "$BUILD_SCRIPT" HASH "$hash" VERSION "$ver"
    else
        echo "deploy: $HOST is up to date ($ver)"
    fi
    remote "$RESTART_SCRIPT"
}

tunnel_up(){
    ssh -S "$TUNNEL_SOCKET" -O check -- "$HOST" >/dev/null 2>&1
}

connect(){
    if [ "$DEPLOY" = 1 ]; then deploy; fi
    if tunnel_up; then
        echo "connect: 127.0.0.1:$LOCAL_PORT already forwards to $HOST"
    else
        if lsof -nP -iTCP:"$LOCAL_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
            echo "connect: something else listens on 127.0.0.1:$LOCAL_PORT here:" >&2
            lsof -nP -iTCP:"$LOCAL_PORT" -sTCP:LISTEN >&2 || true
            echo "stop it (for a local service: pkill -f '4coder-markers serve' or 4coder-markers daemon stop)," >&2
            echo "or pass --local-port P and set agent_markers_port = P in config.4coder" >&2
            exit 1
        fi
        # NOTE: a connection of its own, so the forward outlives 4coder's shared one
        ssh -f -N -M -S "$TUNNEL_SOCKET" -o BatchMode=yes -o ConnectTimeout=10 \
            -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
            -L "127.0.0.1:$LOCAL_PORT:127.0.0.1:$REMOTE_PORT" -- "$HOST"
        echo "connect: 127.0.0.1:$LOCAL_PORT now forwards to $HOST:$REMOTE_PORT"
    fi
    local health
    health="$(curl -s --max-time 3 "http://127.0.0.1:$LOCAL_PORT/v1/health" || true)"
    if [ -z "$health" ]; then
        echo "connect: the tunnel is up but nothing answered through it" >&2
        exit 1
    fi
    echo "connect: $health"
}

case "$CMD" in
    deploy) deploy;;
    connect) connect;;
    disconnect)
        if tunnel_up; then
            ssh -S "$TUNNEL_SOCKET" -O exit -- "$HOST" 2>/dev/null
            echo "disconnect: closed 127.0.0.1:$LOCAL_PORT -> $HOST"
        else
            echo "disconnect: no tunnel to $HOST on 127.0.0.1:$LOCAL_PORT"
        fi;;
    status)
        remote 'if [ -x "$DIR/4coder-markers" ]; then "$DIR/4coder-markers" daemon status --state "$STATE"; else echo "not installed in $DIR"; fi' || true
        if tunnel_up; then echo "tunnel: 127.0.0.1:$LOCAL_PORT -> $HOST:$REMOTE_PORT"; else echo "tunnel: none on 127.0.0.1:$LOCAL_PORT"; fi;;
    stop)
        remote '"$DIR/4coder-markers" daemon stop --state "$STATE"';;
    *) usage;;
esac
